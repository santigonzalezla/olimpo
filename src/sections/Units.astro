---
import UnitCard from "../components/units/UnitCard.astro";
import PlansModal from "../components/units/PlansModal/PlansModal";
import aptplano from "../assets/images/apartment/aptsalacomedor.png";
import studio1 from "../assets/images/studio/VISTA APARTAESTUDIO 1.png";

const units = [
  {
    name: "Apartaestudio",
    description:
      "Funcional, moderno y pensado para quien quiere vivir bien sin complicaciones. Tu primer hogar propio, en el lugar correcto.",
    beds: 1,
    baths: 1,
    image: studio1.src,
  },
  {
    name: "3 Alcobas",
    description:
      "El hogar que tu familia merece. Espacio de sobra para vivir, crecer y crear los recuerdos que duran toda la vida.",
    beds: 3,
    baths: 2,
    image: aptplano.src,
  },
];
---

<section class="units" id="planos">
  <div class="unitsInner">
    <h2 class="unitsTitle">Es hora de elegir tu espacio ideal</h2>
    <div class="unitsCardsWrap">
      <div class="unitsGrid">
        {units.map((unit) => (
          <UnitCard
            name={unit.name}
            description={unit.description}
            beds={unit.beds}
            baths={unit.baths}
            image={unit.image}
          />
        ))}
      </div>
    </div>
  </div>
</section>
<PlansModal client:load />

<style>
  .units {
    background: var(--c-dark);
    height: 100vh;
    padding: 80px 0 0;
    display: flex;
    flex-direction: column;
  }

  .unitsInner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--px);
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .unitsCardsWrap {
    display: contents;
  }

  .unitsTitle {
    font-family: 'Satoshi', sans-serif;
    font-weight: 700;
    font-size: 42px;
    line-height: 1.4;
    color: #fff;
    max-width: 420px;
  }

  .unitsGrid {
    display: flex;
    gap: 15px;
  }

  @media (max-width: 1024px) {
    .units {
      height: auto;
      padding-bottom: 60px;
    }

    .unitsTitle {
      font-size: 34px;
    }
  }

  @media (max-width: 767px) {
    .units {
      height: 100dvh;
      padding: 48px 0;
    }

    .unitsInner {
      gap: 24px;
    }

    .unitsTitle {
      font-size: 28px;
      flex-shrink: 0;
    }

    .unitsCardsWrap {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }

    .unitsGrid {
      flex: 1;
      min-height: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 12px;
      scrollbar-width: none;
      align-items: center;
    }

    .unitsGrid::-webkit-scrollbar {
      display: none;
    }
  }
</style>
