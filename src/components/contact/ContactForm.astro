---
import ArrowRight from "../../assets/svg/arrowRight.svg";
---

<div class="formBox">
  <form id="contactForm" class="contactForm" method="POST">
    <input class="field" type="text" name="nombre" placeholder="Nombre" required />
    <input class="field" type="email" name="email" placeholder="Email" required />
    <div class="row">
      <input class="field" type="tel" name="telefono" placeholder="Teléfono" />
      <div class="selectWrap">
        <select class="field select" name="tipo" required>
          <option value="" disabled selected>Tipo de apartamento</option>
          <option value="studio">Apartaestudio</option>
          <option value="3hab">3 Alcobas</option>
        </select>
        <svg class="selectArrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </div>
    </div>
    <textarea class="field textarea" name="mensaje" placeholder="Mensaje"></textarea>
    <button type="submit" class="submit" id="submitBtn">
      <span id="submitLabel">Enviar Mensaje</span>
      <ArrowRight class="submitIcon" id="submitIcon" />
    </button>
    <p id="formStatus" class="formStatus" aria-live="polite"></p>
  </form>
</div>

<script>
  import { actions } from 'astro:actions';

  const form = document.getElementById('contactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const submitLabel = document.getElementById('submitLabel') as HTMLSpanElement;
  const statusEl = document.getElementById('formStatus') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    submitLabel.textContent = 'Enviando...';
    statusEl.textContent = '';
    statusEl.className = 'formStatus';

    const formData = new FormData(form);
    const { error } = await actions.contact(formData);

    if (error) {
      statusEl.textContent = 'Ocurrió un error. Por favor intenta de nuevo.';
      statusEl.classList.add('error');
      submitBtn.disabled = false;
      submitLabel.textContent = 'Enviar Mensaje';
    } else {
      statusEl.textContent = '¡Gracias! Nos pondremos en contacto contigo pronto.';
      statusEl.classList.add('success');
      form.reset();
      submitBtn.disabled = false;
      submitLabel.textContent = 'Enviar Mensaje';
    }
  });
</script>

<style>
  .formBox {
    background: #243447;
    padding: 32px;
    width: 100%;
  }

  .contactForm {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 54px;
    padding: 0 20px;
    background: #000a1b;
    border: none;
    border-radius: 0;
    font-family: 'Satoshi', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #fff;
    outline: none;
    transition: background 0.2s;
  }

  .field::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .field:focus {
    background: #001428;
  }

  .selectWrap {
    position: relative;
  }

  .select {
    cursor: pointer;
    padding-right: 36px;
  }

  .select option {
    background: #0d1f30;
    color: #fff;
  }

  .selectArrow {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  .textarea {
    height: 130px;
    padding: 16px 20px;
    resize: none;
  }

  .submit {
    -webkit-appearance: none;
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 54px;
    padding: 0 32px;
    background: var(--c-blue);
    color: #fff;
    font-family: 'Satoshi', sans-serif;
    font-weight: 600;
    font-size: 15px;
    border: none;
    border-radius: 0;
    cursor: pointer;
    transition: opacity 0.2s;
    align-self: flex-start;
  }

  .submit:hover { opacity: 0.85; }
  .submit:disabled { opacity: 0.5; cursor: not-allowed; }

  .submitIcon {
    width: 18px;
    height: 18px;
    stroke: white;
    flex-shrink: 0;
  }

  .formStatus {
    font-family: 'Satoshi', sans-serif;
    font-size: 14px;
    min-height: 20px;
  }

  .formStatus.success { color: #4ade80; }
  .formStatus.error   { color: #f87171; }

  @media (max-width: 767px) {
    .formBox { padding: 24px 20px; }
    .row { grid-template-columns: 1fr; }
    .submit { width: 100%; justify-content: center; }
  }
</style>
